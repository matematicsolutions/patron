{
  "name": "patron-desktop",
  "version": "1.0.0",
  "description": "PATRON — Desktop dla Prawnika",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prepare:resources": "node scripts/prepare-resources.cjs",
    "e2e:smoke": "node scripts/e2e-smoke.cjs",
    "release:all": "node scripts/release-all.cjs",
    "build": "node scripts/prepare-resources.cjs && electron-builder --win --x64 --publish=never",
    "build:dir": "node scripts/prepare-resources.cjs && electron-builder --win --x64 --dir --publish=never",
    "build:only": "electron-builder --win --x64 --publish=never",
    "build:locale": "node scripts/build-locale.cjs",
    "build:pl": "node scripts/build-locale.cjs pl",
    "build:en": "node scripts/build-locale.cjs en",
    "build:it": "node scripts/build-locale.cjs it",
    "build:de": "node scripts/build-locale.cjs de",
    "build:es": "node scripts/build-locale.cjs es",
    "build:fr": "node scripts/build-locale.cjs fr",
    "build:pt": "node scripts/build-locale.cjs pt"
  },
  "build": {
    "appId": "co.matematicsolutions.patron",
    "productName": "PATRON",
    "copyright": "© 2026 MateMatic",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signingHashAlgorithms": [],
      "sign": null
    },
    "publish": [
      {
        "provider": "github",
        "owner": "matematicsolutions",
        "repo": "patron"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["pl-PL"],
      "language": "1045"
    },
    "extraResources": [
      {
        "from": "dist-resources/backend",
        "to": "backend"
      },
      {
        "from": "dist-resources/frontend",
        "to": "frontend"
      }
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
